# --- WAJIB: Google Apps Script (script.google.com/macros/s/<ID>/exec) ---
GOOGLE_SHEETS_SCRIPT_ID=isi_script_id_kamu_di_sini
GOOGLE_DRIVE_FOLDER_NAME=Captures Data Sayur
UPLOAD_TIMEOUT=45

# --- Hardware (opsional, ada default di scripts/common.py) ---
HX_DOUT=17
HX_SCK=27
CALIBRATION_FACTOR=24.1850
LCD_ADDR=0x27
BTN_PIN=22

# --- Model & kamera (opsional) ---
MODEL_PATH=model/best-fp16.tflite
CONF_THRESH=0.08
IOU_THRESH=0.15
NUM_THREADS=4
WEBCAM_INDEX=0
WEBCAM_WIDTH=1280
WEBCAM_HEIGHT=720
CONFIRM_FRAMES=8
JPEG_QUALITY=70
